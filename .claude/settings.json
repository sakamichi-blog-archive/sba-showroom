{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "mise run check",
            "asyncRewake": true,
            "statusMessage": "Running checks in background..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)"
    ],
    "ask": [
      "Bash(git branch -D *)"
    ]
  },
  "plansDirectory": "./.claude/plans"
}
